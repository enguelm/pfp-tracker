# Copier vers ~/pfp-tracker/config.env (install.sh le fait) et compléter.
# Les lignes vides ou commentées gardent la valeur par défaut du script.

# --- Source des données : passerelle Yacht Devices YDEN-03 ------------------
# Réglages usine du YDEN-03 : serveur n°1 en TCP, port 1456, NMEA 0183.
# yden.local marche via mDNS ; mettre l'IP fixe si le bail statique est posé
# sur le RUTM10 (ex. NMEA_TCP_HOST=192.168.10.20).
NMEA_TCP_HOST=yden.local
NMEA_TCP_PORT=1456

# Secours si la passerelle est injoignable : Signal K sur le Pi (optionnel,
# voir install-signalk.sh). Laisser vide pour désactiver.
SIGNALK_URL=

# Durée d'écoute à chaque passage (secondes) et fraîcheur exigée des valeurs
# Signal K (secondes).
SAMPLE_WINDOW_S=60
MAX_AGE_S=60

# --- Envoi vers le site (à remplir quand Supabase sera déployé) -------------
# Tant que ces deux lignes sont vides, les points sont conservés dans la file
# locale et partiront d'un bloc dès qu'elles seront renseignées.
SUPABASE_FUNCTION_URL=https://uiblqthfbysfxjalwdzw.supabase.co/functions/v1/ingest-position
TRACKER_TOKEN=
